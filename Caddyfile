# Reverse proxy for chinese-chess-webxr.
#
# The only subtle part is the header handling. The application sends
# Cross-Origin-Opener-Policy and Cross-Origin-Embedder-Policy so the page is
# cross-origin isolated, which is what allows SharedArrayBuffer, which is what
# lets the AI run a multi-threaded search over one shared transposition table.
# Caddy passes response headers through untouched, so nothing extra is needed —
# but do not add a header filter here without understanding that.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# WebSockets for live play. Caddy upgrades these automatically.
	reverse_proxy app:8080 {
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
		# A seated game can sit idle for a long time while someone thinks.
		transport http {
			read_timeout 600s
			write_timeout 600s
		}
	}

	log {
		output stdout
		format console
	}
}
