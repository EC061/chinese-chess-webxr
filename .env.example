# ============================================================================
# chinese-chess-webxr — environment
#
# Copy to `.env` next to docker-compose.yml and edit. Only the variables in the
# REQUIRED block have to be set; everything else has a working default.
# ============================================================================

# ---------------------------------------------------------------- REQUIRED --

# Signs session cookies, headset pairing codes, and room passcodes. Generate with:
#   openssl rand -hex 32
# Changing it signs everyone out and invalidates open room passcodes.
# The server refuses to start in production without it.
SESSION_SECRET=

# ---------------------------------------------------------------- OPTIONAL --

# Container image to run. Point this at your own GHCR build.
IMAGE=ghcr.io/ec061/chinese-chess-webxr:latest

# --- Where the reverse proxy finds the app ----------------------------------
#
# TLS is handled by your own reverse proxy; this container just listens on a
# plain HTTP port. Note that WebXR needs a secure origin, so the proxy in front
# of this MUST serve HTTPS — a headset will not start an immersive session
# otherwise.

# Host port to publish.
APP_PORT=8080

# Interface to bind. Leave 0.0.0.0 if the proxy is on another host; set to
# 127.0.0.1 if the proxy runs here, so the port is not exposed to the network.
BIND_ADDR=0.0.0.0

# --- Gameplay & ratings -----------------------------------------------------

# Allow players in without an account.
#
# This is not a fallback — it is the front door. A headset that has never been
# signed in gets a named guest account automatically and goes straight to the
# board, because typing on a headset is miserable and asking for a password
# before the first move is the fastest way to lose a player. Guests can play and
# join rooms but are never rated and never appear on the ladder; a player can
# later claim the same account from their phone and keep their game history.
#
# Set to false only if you want a closed server. Players then see a sign-in
# screen, and the phone-pairing flow is the only way in that does not involve
# typing a password in VR.
ALLOW_GUESTS=true

# Rate games played against the on-device AI.
#
# The AI runs in the player's headset, so the server cannot witness those games.
# It does replay every reported move list through the rules engine and reject
# any result the final position does not support, which stops fabricated wins —
# but it cannot prove the AI really played at the level claimed. Set to false if
# you want the ladder to reflect human-versus-human play only.
RATE_AI_GAMES=true

# Taking back a move (悔棋) in a human-versus-human game makes that game
# unrated. Set to false to let players take moves back in rated games.
UNDO_MAKES_UNRATED=true

# How long an opponent has to accept or decline a take-back request, in ms.
UNDO_RESPONSE_TIMEOUT_MS=30000

# Minimum games before a player appears on the ladder.
LEADERBOARD_MIN_GAMES=5

# --- Capacity & limits ------------------------------------------------------

MAX_ROOMS=200
MAX_ROOMS_PER_USER=3

# Idle rooms are closed after this many ms. Rooms with a game in progress are
# never reaped by this timer.
ROOM_IDLE_MS=900000

# Simultaneous WebSocket connections from one address. Two headsets and a
# desktop behind one home NAT is normal; 24 leaves plenty of room.
MAX_CONNECTIONS_PER_IP=24

# Requests per minute per address against the guessable endpoints: register,
# login, guest, claim, and the pairing endpoints. Pairing *polls* are excluded
# and paced separately — a waiting headset asks every couple of seconds, which
# would eat a per-minute budget meant for password attempts.
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=60000

# --- Sessions ---------------------------------------------------------------

# The session is an HttpOnly cookie, which is also what authenticates the
# WebSocket handshake. Two knobs.

# Send the Secure attribute, without which the cookie is not sent over plain
# HTTP. Leave this unset: it follows PUBLIC_ORIGIN when you have set one, and
# NODE_ENV otherwise. Set it to false only for a development server reached over
# plain HTTP on a LAN address — note that WebXR needs a secure origin anyway, so
# that arrangement cannot run an immersive session.
# SECURE_COOKIES=

# How long "stay signed in on this device" lasts, in days.
#
# 400 is both the default and the ceiling, because that is the longest expiry
# Chromium will honour on a cookie — and Meta's browser is Chromium. The clamp
# is measured from the moment the cookie is set, so the server re-stamps it
# whenever a player opens the app after a day away, which slides the window
# forward and keeps a headset signed in indefinitely. Lower it if you want
# sessions on shared headsets to age out on their own.
SESSION_PERSIST_DAYS=400

# --- Headset pairing -------------------------------------------------------

# Signing in from a phone: the headset shows an eight-character code, the player
# types it at /link on their phone, and the headset picks up the session. This
# is the device authorization grant (RFC 8628), and it is the only sign-in path
# that requires no typing inside a headset.

# How long a displayed pairing code stays valid, in ms. Long enough to find your
# phone and unlock it; short enough that a code left on screen goes stale.
LINK_CODE_TTL_MS=600000

# How often a waiting headset may poll, in ms. Polling faster gets a slow-down.
LINK_POLL_INTERVAL_MS=2000

# Minimum gap between AI game reports from one player, in ms.
AI_REPORT_COOLDOWN_MS=20000

# --- Platform ---------------------------------------------------------------

# Interface the server listens on inside the container. This is not the same
# knob as BIND_ADDR: that one decides who can reach the published port, this one
# decides whether the container answers on it at all. Leave it at 0.0.0.0 —
# 127.0.0.1 here makes the app unreachable even from the proxy.
HOST=0.0.0.0

# Send Cross-Origin-Opener-Policy and Cross-Origin-Embedder-Policy.
#
# Keep this on, and make sure your reverse proxy passes both headers through
# untouched. Without cross-origin isolation the browser will not hand out a
# SharedArrayBuffer, and the AI drops from a multi-threaded search sharing one
# transposition table to a single worker — roughly two plies of strength.
CROSS_ORIGIN_ISOLATION=true

# Trust X-Forwarded-For for client addresses. Keep true behind a reverse proxy
# that sets it. Set to false if the port is reachable directly, or the per-IP
# connection and rate limits can be spoofed with a forged header.
TRUST_PROXY=true

# Canonical public origin, e.g. https://xiangqi.example.com
#
# Used only to decide whether to send HSTS. Leave blank if your proxy already
# sends Strict-Transport-Security, which is the usual arrangement.
PUBLIC_ORIGIN=

# debug | info | warn | error
LOG_LEVEL=info

# Where the SQLite database lives inside the container. It is on a named volume;
# WAL mode means the -wal and -shm sidecars live beside it.
DATABASE_PATH=/data/xiangqi.db
