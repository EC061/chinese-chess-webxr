# Copy to `.env` beside docker-compose.yml. 1Panel reads it automatically —
# `docker compose config` in the compose directory will show the resolved values.
#
# Only SESSION_SECRET has to be set; the compose file supplies the same defaults
# the server itself uses for everything below it.

# Generate on the host so it never passes through a clipboard:
#   sed -i "s|^SESSION_SECRET=.*|SESSION_SECRET=$(openssl rand -hex 32)|" .env
# Changing it signs everyone out and invalidates open room passcodes.
SESSION_SECRET=

# --- Gameplay & ratings -----------------------------------------------------
ALLOW_GUESTS=true
RATE_AI_GAMES=true
UNDO_MAKES_UNRATED=true
UNDO_RESPONSE_TIMEOUT_MS=30000
LEADERBOARD_MIN_GAMES=5

# --- Capacity ---------------------------------------------------------------
MAX_ROOMS=200
MAX_ROOMS_PER_USER=3
ROOM_IDLE_MS=900000
MAX_CONNECTIONS_PER_IP=24
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_MS=60000
AI_REPORT_COOLDOWN_MS=20000

# --- Platform ---------------------------------------------------------------
# Only decides whether the app sends HSTS. Note that a CDN in front of this may
# override the header — see the README.
PUBLIC_ORIGIN=

# debug | info | warn | error
LOG_LEVEL=info
